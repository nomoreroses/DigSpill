; DigSpill - reglages lus par DigSpill.exe au demarrage.
; Copier ce fichier en "digspill.ini" a la racine de la cle OUTILS, le remplir,
; puis passer la cle en lecture seule. Encodage : UTF-8.

[technicien]
prenom=
nom=
societe=

[options]
