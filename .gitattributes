# Les .bat ne fonctionnent pas avec des fins de ligne LF : forcer CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.yaml text eol=crlf
*.md   text eol=lf
# polices et images embarquees dans l'interface : jamais de conversion de fin de ligne
*.woff2 binary
*.png   binary
*.ico   binary
*.ttf   binary
